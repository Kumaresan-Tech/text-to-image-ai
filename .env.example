# ============================================
# Environment Variables - Copy to .env
# ============================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/text2img
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/text2img

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
BACKEND_SECRET_KEY=change-me-to-a-random-secret-key
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- AI / Image Generation ---
AI_PROVIDER=comfyui
COMFYUI_URL=http://localhost:8188
COMFYUI_TIMEOUT=180
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-1.1-pro

# --- LLM (Prompt Enhancement) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Storage ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=text2img-dev
AWS_REGION=us-east-1
LOCAL_STORAGE_PATH=./storage

# --- Auth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Monitoring ---
SENTRY_DSN=
